#!/usr/bin/env bash
#
# bin/agent-check — AIエージェントの「完了条件」チェッカー
#
# 使い方:
#   ./bin/agent-check          # 全部の検査を走らせる
#   ./bin/agent-check --quick  # Rust を飛ばしてフロントだけ
#   ./bin/agent-check --fix    # 自動修正できるものを直してから検査する
#
# 環境変数:
#   AGENT_CHECK_BASE=main      # Rust 差分判定の基準ブランチ（既定: main）
#
# 終了コード: 0=green / 1=いずれかの検査が失敗

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# 【重要】NODE_ENV はステージ単位で指定する。スクリプト全体で固定してはいけない。
#
#   Claude デスクトップのようなホストプロセスは NODE_ENV=production を持っており、
#   そこから起動したエージェントのシェルはそれを継承する。
#   その状態で vitest を走らせると React が production ビルドに解決され、
#   act() が使えず @testing-library/react のテストが全滅する。
#   一方でスクリプト全体を NODE_ENV=test で固定すると、今度は vite build の
#   挙動が本番と変わってしまう。
#
#   だからステージごとに「そのステージが必要とする NODE_ENV」を渡す。
#   継承した値をそのまま使うステージを作らないこと。
NODE_ENV_TEST=test
NODE_ENV_BUILD=production

QUICK=0
FIX=0
for arg in "$@"; do
  case "$arg" in
    --quick) QUICK=1 ;;
    --fix)   FIX=1 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

BASE="${AGENT_CHECK_BASE:-main}"

PNPM="pnpm"
command -v pnpm >/dev/null 2>&1 || { echo "pnpm が見つかりません" >&2; exit 2; }

FAILED_STAGE=""
TIMINGS=""

run_stage() {
  # run_stage <stage名> <説明> <コマンド...>
  local name="$1"; shift
  local desc="$1"; shift
  local start end out rc
  printf '── %-10s %s\n' "$name" "$desc"
  start=$(date +%s)
  out=$("$@" 2>&1)
  rc=$?
  end=$(date +%s)
  TIMINGS="${TIMINGS}${name}:$((end - start))s "
  if [ $rc -ne 0 ]; then
    echo "$out" | tail -40
    [ -z "$FAILED_STAGE" ] && FAILED_STAGE="$name"
    return 1
  fi
  return 0
}

if [ "$FIX" = "1" ]; then
  echo "── fix       biome check --write"
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec biome check --write . >/dev/null 2>&1
  ( cd src-tauri && cargo fmt --all ) >/dev/null 2>&1
fi

OK=1

# --- フロントエンド ---------------------------------------------------------
run_stage lint "biome check" \
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec biome check . || OK=0

run_stage typecheck "tsc --noEmit" \
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec tsc --noEmit || OK=0

run_stage build "vite build" \
  env NODE_ENV="$NODE_ENV_BUILD" $PNPM exec vite build || OK=0

# --- Rust -------------------------------------------------------------------
# src-tauri に差分が無いときは飛ばす（clippy のフルビルドは50秒前後かかるため）
if [ "$QUICK" = "1" ]; then
  echo "── rust       skip (--quick)"
elif ! git rev-parse --verify "$BASE" >/dev/null 2>&1; then
  echo "── rust       skip (基準ブランチ $BASE が見つからない)"
elif git diff --quiet "$BASE"...HEAD -- src-tauri && git diff --quiet HEAD -- src-tauri; then
  echo "── rust       skip (src-tauri に差分なし)"
else
  # 【重要】cargo の設定探索はカレントディレクトリ基準なので、
  #   --manifest-path ではなく cd してから叩くこと。
  run_stage rustfmt "cargo fmt --check" \
    bash -c 'cd src-tauri && cargo fmt --all -- --check' || OK=0
  run_stage clippy "cargo clippy -D warnings" \
    bash -c 'cd src-tauri && cargo clippy --all-targets -- -D warnings' || OK=0
  run_stage rusttest "cargo test" \
    bash -c 'cd src-tauri && cargo test' || OK=0
fi

echo
echo "=== AGENT-CHECK RESULT ==="
if [ "$OK" = "1" ]; then
  echo "STATUS: PASS"
  echo "TIMINGS: ${TIMINGS}"
  echo "NEXT: PR を作成してよい。マージは人間が行うため、マージはしないこと。"
  exit 0
else
  echo "STATUS: FAIL"
  echo "FAILED_STAGE: $FAILED_STAGE"
  echo "TIMINGS: ${TIMINGS}"
  echo "NEXT: 上の $FAILED_STAGE エラーを修正し、bin/agent-check を再実行すること。"
  echo "NEXT: green になるまで PR を作成しないこと。"
  exit 1
fi
